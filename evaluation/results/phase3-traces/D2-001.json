      "sql": "SELECT rp.billing_month, SUM(rp.amount_paid) AS total_rent_collected FROM rent_payments rp JOIN leases l ON rp.lease_id = l.lease_id JOIN units u ON l.unit_id = u.unit_id JOIN properties p ON u.property_id = p.property_id WHERE p.city = '上海' AND rp.billing_month >= '2026-01-01' AND rp.billing_month < '2027-01-01' GROUP BY rp.billing_month ORDER BY rp.billing_month ASC;",
